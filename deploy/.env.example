# Copy to .env and fill in. Never commit .env.

# The hostname you will connect to. Its A record must already point at this
# box before you start the stack, or Let's Encrypt cannot issue a certificate.
DOMAIN=mcp.example.com

# The bearer token clients must send. Generate a real one:
#   openssl rand -hex 32
# Anyone holding this can use all 37 tools on your server and your IP.
MCP_TOKEN=replace-me-with-openssl-rand-hex-32

# Upstream rate-limit guards. Defaults are conservative and usually fine.
TV_TA_MAX_CONCURRENCY=4
TV_TA_MIN_SPACING=0.8
